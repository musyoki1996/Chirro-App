rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'mutisya104@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true; // Public profiles
      allow create: if isOwner(userId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 3 &&
        request.resource.data.username.size() <= 50 &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() <= 100;
      allow update: if (isOwner(userId) || isAdmin()) &&
        request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Posts & Action Layer
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 5000 &&
        request.resource.data.postType in ['discussion', 'question', 'poll', 'event', 'project', 'opportunity', 'community_request'];
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorId ||
        isAdmin() ||
        // Allow updating likesCount, repliesCount, or pollVotes
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'repliesCount', 'pollVotes', 'repostsCount'])
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());

      // Threaded replies
      match /replies/{replyId} {
        allow read: if true;
        allow create: if isSignedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 2000;
        allow update: if isSignedIn() && request.auth.uid == resource.data.authorId;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isAdmin());
      }
    }

    // Circles (Communities)
    match /circles/{circleId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.ownerId || isAdmin());
    }

    // Circle Members
    match /circleMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }

    // Opportunity Responses
    match /opportunityResponses/{responseId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.respondentId ||
        request.auth.uid == resource.data.ownerId ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        request.resource.data.respondentId == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 2000;
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid == resource.data.respondentId ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.respondentId || isAdmin());
    }

    // Likes
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Bookmarks
    match /bookmarks/{bookmarkId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    // Follows
    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.followerId;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Reports (Moderation & Trust)
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
